def plot_comparison_2d(interp_data, df, component='Bx', res=(200, 600)):
    
        x_vals = np.sort(pd.to_numeric(df["x_mm"]).unique())
        y_vals = np.sort(df["y_mm"].unique())
        z_vals = np.sort(pd.to_numeric(df["z_mm"]).unique())
    
        y_fixed = y_vals[0]  
    
        # Filter original data for this plane
        df_plane = df[df['y_mm'] == y_fixed]
    
        # Create figure with 2 subplots
        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))
    
        # Plot 1: Original data (scatter plot)
        if component == 'Bx':
            field_vals = df_plane['Bx_T']
        elif component == 'By':
             field_vals = df_plane['By_T']
        elif component == 'Bz':
            field_vals = df_plane['Bz_T']
        else:
            field_vals = np.sqrt(df_plane['Bx_T']**2 + df_plane['By_T']**2 + df_plane['Bz_T']**2)
    
        sc1 = ax1.scatter(df_plane['x_mm'], df_plane['z_mm'], c=field_vals, 
                     s=20, cmap='viridis', alpha=0.8)
        ax1.set_xlabel('x [mm]')
        ax1.set_ylabel('z [mm]')
        ax1.set_title(f'Original Data ({component}) at y={y_fixed:.3f} mm')
        plt.colorbar(sc1, ax=ax1, label=f'{component} [T]')
        ax1.grid(True, alpha=0.3)
    
        # Plot 2: Interpolated data (heatmap)
        # Create dense grid for interpolation
        Xg = np.linspace(x_vals.min(), x_vals.max(), res[0])
        Zg = np.linspace(z_vals.min(), z_vals.max(), res[1])
        X, Z = np.meshgrid(Xg, Zg, indexing='ij')
    
        P = np.column_stack([X.ravel(), np.full(X.size, y_fixed, dtype=float), Z.ravel()])
    
        # Evaluate interpolators
        Bx_values = interp_data['Bx'](P)
        By_values = interp_data['By'](P)
        Bz_values = interp_data['Bz'](P)
    
        Bx = Bx_values.reshape(X.shape)
        By = By_values.reshape(X.shape)
        Bz = Bz_values.reshape(X.shape)
    
        if component == 'Bmag':
           Img = np.sqrt(Bx**2 + By**2 + Bz**2)
           cbar_label = '|B| [T]'
        else:
            Img = {'Bx': Bx, 'By': By, 'Bz': Bz}[component]
            cbar_label = component + ' [T]'
    
        extent = [Xg.min(), Xg.max(), Zg.min(), Zg.max()]
        im = ax2.imshow(Img, origin='lower', aspect='auto', 
                    extent=extent, cmap='viridis')
        ax2.set_xlabel('x [mm]')
        ax2.set_ylabel('z [mm]')
        ax2.set_title(f'Interpolated Field ({component}) at y={y_fixed:.3f} mm')
        plt.colorbar(im, ax=ax2, label=cbar_label)
    
        plt.tight_layout()
        plt.show()
    
    # Also plot difference if you want
        plot_difference_2d(df_plane, Img, Xg, Zg, component)
    
def plot_difference_2d(df_plane, interpolated_field, Xg, Zg, component='Bx'):
    
    # Create interpolation for difference comparison
        from scipy.interpolate import griddata
    
    # Extract original data
        z_orig = df_plane['z_mm'].values
        x_orig = df_plane['x_mm'].values
        if component == 'Bx':
            field_orig = df_plane['Bx_T'].values
        elif component == 'By':
            field_orig = df_plane['By_T'].values
        elif component == 'Bz':
            field_orig = df_plane['Bz_T'].values
        else:
            field_orig = np.sqrt(df_plane['Bx_T']**2 + 
                            df_plane['By_T']**2 + 
                            df_plane['Bz_T']**2).values
    
    # Sample interpolated field at original points
        X_grid, Z_grid = np.meshgrid(Xg, Zg, indexing='ij')
    
    # For each original point, find nearest interpolated value
        diffs = []
        for i in range(len(x_orig)):
            # Find closest grid point
            x_idx = np.argmin(np.abs(Xg - x_orig[i]))
            z_idx = np.argmin(np.abs(Zg - z_orig[i]))
        
            interpolated_val = interpolated_field[x_idx, z_idx]
            original_val = field_orig[i]
            diffs.append(interpolated_val - original_val)
    
        diffs = np.array(diffs)
    
        plt.figure(figsize=(10, 6))
        sc = plt.scatter(x_orig, z_orig, c=diffs, s=30, 
                    cmap='coolwarm', alpha=0.8, 
                    vmin=-np.max(np.abs(diffs)), 
                    vmax=np.max(np.abs(diffs)))
        plt.colorbar(sc, label=f'Difference ({component}) [T]')
        plt.xlabel('x [mm]')
        plt.ylabel('z [mm]')
        plt.title(f'Difference (Interpolated - Original) for {component}\n' +
             f'Max diff: {np.max(np.abs(diffs)):.2e} T, ' +
             f'RMS: {np.sqrt(np.mean(diffs**2)):.2e} T')
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        plt.show()  

